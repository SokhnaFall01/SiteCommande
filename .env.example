# ---- Base de données ----
# SQLite pour le développement. En production, utilise PostgreSQL :
# DATABASE_URL="postgresql://user:password@localhost:5432/sitecommande"
DATABASE_URL="file:./dev.db"

# ---- Application ----
# Domaine du site (serveur dédié avec Caddy intégré). Ex : samaboutik.com
DOMAIN="samaboutik.exemple.com"
# URL publique complète (doit correspondre à DOMAIN, en https)
APP_URL="https://samaboutik.exemple.com"
# Secret pour signer les sessions (générer une longue chaîne aléatoire)
SESSION_SECRET="change-moi-avec-une-longue-chaine-aleatoire-de-32-caracteres-min"

# Compte admin créé par le seed (prisma db seed)
ADMIN_EMAIL="admin@sitecommande.sn"
ADMIN_PASSWORD="changeMoi123"

# ---- Publication payante ----
DEVISE="XOF"
PRIX_PUBLICATION="300"     # prix en F CFA par article (au-delà du 1er gratuit)

# ---- Upload de photos ----
MAX_UPLOAD_MB="3"          # taille maximale par photo (en Mo)

# ---- Paiement mobile money ----
# "mock" = mode test (confirme automatiquement, aucun argent) ; "paydunya" = réel
PAYMENT_PROVIDER="mock"

# PayDunya (https://paydunya.com) — à remplir quand le compte marchand est prêt
PAYDUNYA_MODE="test"       # "test" ou "live"
PAYDUNYA_MASTER_KEY=""
PAYDUNYA_PRIVATE_KEY=""
PAYDUNYA_PUBLIC_KEY=""
PAYDUNYA_TOKEN=""

# ---- Emails (SMTP / Gmail) ----
# Les notifications de commande sont envoyées par email via Gmail.
# En dev, laisser SMTP_USER / SMTP_PASSWORD vides : les emails s'affichent
# alors dans la console (aucun envoi réel).
#
# Pour activer l'envoi réel avec Gmail :
#   1. Activer la validation en 2 étapes sur le compte Google.
#   2. Créer un "mot de passe d'application" :
#      https://myaccount.google.com/apppasswords
#   3. Mettre l'adresse Gmail dans SMTP_USER et le mot de passe
#      d'application (16 caractères, sans espaces) dans SMTP_PASSWORD.
#
# NB : le mot de passe habituel du compte ne fonctionne PAS, il faut
#      obligatoirement un mot de passe d'application.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""              # votre adresse Gmail, ex : maboutique@gmail.com
SMTP_PASSWORD=""          # mot de passe d'application Google (16 caractères)
# Laisser vide pour utiliser automatiquement "SiteCommande <SMTP_USER>".
SMTP_FROM=""
